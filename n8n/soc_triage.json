        "options": {
          "append": true
        }
      },
      "id": "975b3211-4334-55ed-ba24-fe3dbd96c62d",
      "name": "Append to incidents.jsonl",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1320,
        500
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "81effcd4-caa4-5afb-83f0-59ebb2fc3252",
              "leftValue": "={{ $json.route }}",
              "rightValue": "alert",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1f952f95-54da-5117-b0d4-0d9192436af2",
      "name": "Needs an alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        400
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json.record;\nconst alert = {\n  kind: 'alert',\n  stage: 'model',\n  at: r.at,\n  source: r.source,\n  severity: r.severity,\n  verdict: r.verdict,\n  attack_type: r.attack_type,\n  technique_ids: r.technique_id ? [r.technique_id] : [],\n  summary: r.summary,\n  recommendations: r.recommendations,\n  rules_raised_severity: r.rules_raised_severity,\n};\nreturn { json: { line: JSON.stringify(alert) + '\\n' } };"
      },
      "id": "2013d643-aa64-5d6c-ad0d-7f8cd6f66567",
      "name": "Model alert",
